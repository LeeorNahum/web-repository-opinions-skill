import test from "node:test";
import assert from "node:assert/strict";
import {
  startUpload, finalizeUpload, claimSummary, finishSummary, retrySummary, closeUpload,
  SUMMARY_MAX_BYTES as S,
} from "../.test-build/uploads.js";
import { QuotaExceeded, UploadError } from "../.test-build/errors.js";

// This adapter supplies serializability and rollback, not a production database.
function fixture(cap = 1_000_000) {
  let state = {
    accounts: new Map([["a", { id: "a", used: 0, reserved: 0, cap }],
      ["b", { id: "b", used: 0, reserved: 0, cap }]]),
    uploads: new Map(), retries: new Map(), outbox: new Map(), nextId: 0,
  };
  let tail = Promise.resolve();
  const objects = new Map();
  const control = { failEnqueue: false, failSign: false, inspections: 0, afterInspect: null };
  const db = {
    async transaction(body) {
      let unlock;
      const wait = tail;
      tail = new Promise(resolve => { unlock = resolve; });
      await wait;
      const draft = structuredClone(state);
      const tx = {
        accounts: {
          get: async id => structuredClone(draft.accounts.get(id)),
          patch: async (id, patch) => Object.assign(draft.accounts.get(id), patch),
        },
        uploads: {
          get: async id => structuredClone(draft.uploads.get(id) ?? null),
          findRequest: async (accountId, requestId) => structuredClone(
            [...draft.uploads.values()].find(u => u.accountId === accountId && u.requestId === requestId) ?? null),
          insert: async upload => {
            const row = { ...upload, id: String(++draft.nextId) };
            draft.uploads.set(row.id, row);
            return structuredClone(row);
          },
          patch: async (id, patch) => Object.assign(draft.uploads.get(id), patch),
        },
        summaryRetries: {
          find: async (id, key) => draft.retries.get(JSON.stringify([id, key])) ?? null,
          insert: async (id, key, attempt) => draft.retries.set(JSON.stringify([id, key]), attempt),
        },
        enqueue: async (key, name, payload) => {
          if (control.failEnqueue) throw new Error("outbox unavailable");
          if (!draft.outbox.has(key)) draft.outbox.set(key, { name, payload });
        },
      };
      try {
        const result = await body(tx);
        state = draft;
        return result;
      } finally { unlock(); }
    },
  };
  const ctx = {
    accountId: "a", db,
    storage: {
      signPut: async (id, options) => {
        if (control.failSign) throw new Error("signing unavailable");
        return `signed:${id}:${options.size}:${options.expiresAt}`;
      },
      inspect: async id => {
        control.inspections++;
        const result = structuredClone(objects.get(id) ?? null);
        await control.afterInspect?.();
        return result;
      },
    },
  };
  function invariant() {
    for (const account of state.accounts.values()) {
      const rows = [...state.uploads.values()].filter(u => u.accountId === account.id);
      assert.equal(account.reserved, rows.reduce((n, u) => n + u.reserved, 0));
      assert.equal(account.used, rows.filter(u => u.status === "ready")
        .reduce((n, u) => n + u.size + u.summaryBytes, 0));
      assert.ok(account.used >= 0 && account.reserved >= 0);
      assert.ok(account.used + account.reserved <= account.cap);
    }
  }
  return { ctx, control, objects, state: () => state, invariant };
}

const start = (f, requestId = "one", size = 100) =>
  startUpload(f.ctx, { name: "document.txt", size, requestId });
async function ready(f, requestId = "one", size = 100) {
  const result = await start(f, requestId, size);
  f.objects.set(result.uploadId, { size, version: "immutable-v1" });
  await finalizeUpload(f.ctx, result);
  return { uploadId: result.uploadId, attempt: 1 };
}
const code = value => error => error instanceof UploadError && error.code === value;

test("eight parallel admissions cannot overcommit, including summary headroom", async () => {
  const f = fixture(3 * (S + 100));
  const results = await Promise.allSettled(Array.from({ length: 8 }, (_, i) => start(f, String(i))));
  assert.equal(results.filter(r => r.status === "fulfilled").length, 3);
  for (const r of results.filter(r => r.status === "rejected")) assert.ok(r.reason instanceof QuotaExceeded);
  assert.equal(f.state().accounts.get("a").reserved, 3 * (S + 100));
  f.invariant();
});

test("concurrent start retries and a lost signing response reserve only once", async () => {
  const f = fixture();
  f.control.failSign = true;
  await assert.rejects(start(f), /signing unavailable/);
  f.control.failSign = false;
  const results = await Promise.all(Array.from({ length: 8 }, () => start(f)));
  assert.equal(new Set(results.map(r => r.uploadId)).size, 1);
  assert.equal(new Set(results.map(r => r.expiresAt)).size, 1);
  assert.equal(f.state().uploads.size, 1);
  await assert.rejects(start(f, "one", 101), code("request_conflict"));
  f.invariant();
});

test("invalid metadata never creates a reservation", async () => {
  const f = fixture();
  for (const size of [-1, 0.5, NaN, Infinity, Number.MAX_SAFE_INTEGER]) {
    await assert.rejects(start(f, "bad", size), code("invalid_input"));
  }
  await assert.rejects(startUpload(f.ctx, { name: "x", size: 1 }), code("invalid_input"));
  await assert.rejects(startUpload(f.ctx, { name: " ", size: 1, requestId: "bad" }), code("invalid_input"));
  assert.equal(f.state().uploads.size, 0);
  const zero = await start(f, "zero", 0);
  assert.equal(f.state().uploads.get(zero.uploadId).reserved, S);
  f.invariant();
});

test("exact cap includes summary; one byte over is refused", async () => {
  const f = fixture(S + 100);
  await assert.rejects(start(f, "too-big", 101), QuotaExceeded);
  await start(f);
  f.invariant();
});

test("finalize retries transfer bytes once and commit one durable summary intent", async () => {
  const f = fixture();
  const input = await start(f);
  f.objects.set(input.uploadId, { size: 100, version: "v1" });
  await Promise.all(Array.from({ length: 8 }, () => finalizeUpload(f.ctx, input)));
  assert.equal(f.state().accounts.get("a").used, 100);
  assert.equal(f.state().accounts.get("a").reserved, S);
  assert.equal(f.state().outbox.size, 1);
  assert.equal(f.state().uploads.get(input.uploadId).objectVersion, "v1");
  assert.equal((await start(f)).url, undefined);
  f.invariant();
});

test("outbox failure rolls back finalize and supports a later retry", async () => {
  const f = fixture();
  const input = await start(f);
  f.objects.set(input.uploadId, { size: 100, version: "v1" });
  f.control.failEnqueue = true;
  await assert.rejects(finalizeUpload(f.ctx, input), /outbox unavailable/);
  assert.equal(f.state().uploads.get(input.uploadId).status, "uploading");
  assert.equal(f.state().accounts.get("a").used, 0);
  assert.equal(f.state().outbox.size, 0);
  f.invariant();
  f.control.failEnqueue = false;
  await finalizeUpload(f.ctx, input);
  f.invariant();
});

test("ownership, missing bytes, and size mismatches fail without charging", async () => {
  const f = fixture();
  const input = await start(f);
  await assert.rejects(finalizeUpload({ ...f.ctx, accountId: "b" }, input), code("not_found"));
  assert.equal(f.control.inspections, 0);
  await assert.rejects(finalizeUpload(f.ctx, input), code("object_missing"));
  f.objects.set(input.uploadId, { size: 101, version: "v1" });
  await assert.rejects(finalizeUpload(f.ctx, input), code("size_mismatch"));
  assert.equal(f.state().outbox.size, 0);
  f.invariant();
});

test("one summary claimant; settlement counts UTF-8 bytes and is idempotent", async () => {
  const f = fixture();
  const input = await ready(f);
  const claims = await Promise.all(Array.from({ length: 8 }, () => claimSummary(f.ctx, input)));
  assert.equal(claims.filter(Boolean).length, 1);
  assert.deepEqual(claims.find(Boolean), { objectVersion: "immutable-v1", maxBytes: S });
  await Promise.all(Array.from({ length: 8 }, () => finishSummary(f.ctx, { ...input, text: "é🌟" })));
  assert.equal(f.state().accounts.get("a").used, 106);
  assert.equal(f.state().accounts.get("a").reserved, 0);
  assert.equal(f.state().uploads.get(input.uploadId).summaryText, "é🌟");
  f.invariant();
});

test("summary failure releases only its reservation; manual retries have durable keys", async () => {
  const f = fixture();
  const input = await ready(f);
  await claimSummary(f.ctx, input);
  await finishSummary(f.ctx, { ...input, text: null });
  assert.equal(f.state().accounts.get("a").used, 100);
  assert.equal(f.state().accounts.get("a").reserved, 0);
  const retryInput = { uploadId: input.uploadId, requestId: "retry1" };
  const retries = await Promise.all(Array.from({ length: 8 }, () => retrySummary(f.ctx, retryInput)));
  assert.ok(retries.every(r => r.attempt === 2));
  assert.equal(f.state().outbox.size, 2);
  assert.equal(await claimSummary(f.ctx, input), null);
  const second = { ...input, attempt: 2 };
  await claimSummary(f.ctx, second);
  await finishSummary(f.ctx, { ...input, text: "stale" });
  assert.equal(f.state().uploads.get(input.uploadId).summaryStatus, "running");
  await finishSummary(f.ctx, { ...second, text: null });
  assert.deepEqual(await retrySummary(f.ctx, { ...retryInput, requestId: "retry2" }), { attempt: 3 });
  assert.deepEqual(await retrySummary(f.ctx, retryInput), { attempt: 2 });
  assert.equal(f.state().outbox.size, 3);
  f.invariant();
});

test("retry admission and outbox failure do not leak reservations", async () => {
  const f = fixture(S + 100);
  const input = await ready(f);
  await claimSummary(f.ctx, input);
  await finishSummary(f.ctx, { ...input, text: null });
  const other = await start(f, "other", 0);
  await assert.rejects(retrySummary(f.ctx, { ...input, requestId: "retry" }), QuotaExceeded);
  await closeUpload(f.ctx, { ...other, reason: "cancel" });
  f.control.failEnqueue = true;
  await assert.rejects(retrySummary(f.ctx, { ...input, requestId: "retry" }), /outbox unavailable/);
  assert.equal(f.state().uploads.get(input.uploadId).summaryAttempt, 1);
  assert.equal(f.state().retries.size, 0);
  f.invariant();
});

test("oversized summaries are rejected; failure settlement preserves the original", async () => {
  const f = fixture();
  const input = await ready(f);
  await claimSummary(f.ctx, input);
  await assert.rejects(finishSummary(f.ctx, { ...input, text: "x".repeat(S + 1) }), code("summary_too_large"));
  assert.equal(f.state().accounts.get("a").reserved, S);
  await finishSummary(f.ctx, { ...input, text: null });
  f.invariant();
});

test("cancel wins a finalize race after inspect; late writes cannot revive it", async () => {
  const f = fixture();
  const input = await start(f);
  f.objects.set(input.uploadId, { size: 100, version: "v1" });
  f.control.afterInspect = () => closeUpload(f.ctx, { ...input, reason: "cancel" });
  await assert.rejects(finalizeUpload(f.ctx, input), code("upload_closed"));
  await closeUpload(f.ctx, { ...input, reason: "cancel" });
  assert.equal(f.state().accounts.get("a").reserved, 0);
  assert.equal([...f.state().outbox.values()].filter(e => e.name === "summarize").length, 0);
  const cleanup = [...f.state().outbox.values()][0];
  assert.ok(cleanup.payload.notBefore > input.expiresAt);
  f.invariant();
});

test("expiry is idempotent; ready summary reservations do not expire with the upload", async () => {
  const f = fixture();
  const pending = await start(f);
  await closeUpload(f.ctx, { ...pending, reason: "expire" });
  assert.equal(f.state().uploads.get(pending.uploadId).status, "uploading");
  await f.ctx.db.transaction(tx => tx.uploads.patch(pending.uploadId, { expiresAt: 0 }));
  await assert.rejects(finalizeUpload(f.ctx, pending), code("upload_closed"));
  await closeUpload(f.ctx, { ...pending, reason: "expire" });
  await closeUpload(f.ctx, { ...pending, reason: "expire" });
  await assert.rejects(start(f), code("upload_closed"));
  const input = await ready(f, "ready");
  await f.ctx.db.transaction(tx => tx.uploads.patch(input.uploadId, { expiresAt: 0 }));
  await closeUpload(f.ctx, { ...input, reason: "expire" });
  assert.equal(f.state().uploads.get(input.uploadId).reserved, S);
  f.invariant();
});

test("delete/completion races refund once and stale results cannot resurrect data", async () => {
  for (const deleteFirst of [true, false]) {
    const f = fixture();
    const input = await ready(f);
    await claimSummary(f.ctx, input);
    const deletion = () => closeUpload(f.ctx, { ...input, reason: "delete" });
    const completion = () => finishSummary(f.ctx, { ...input, text: "summary" });
    await Promise.all(deleteFirst ? [deletion(), completion()] : [completion(), deletion()]);
    await deletion();
    await completion();
    assert.equal(f.state().uploads.get(input.uploadId).summaryText, undefined);
    assert.equal(f.state().accounts.get("a").used, 0);
    assert.equal(f.state().accounts.get("a").reserved, 0);
    assert.equal(await claimSummary(f.ctx, input), null);
    f.invariant();
  }
});

test("cap reductions block admissions but preserve already reserved work", async () => {
  const f = fixture(S + 100);
  const input = await start(f);
  await f.ctx.db.transaction(tx => tx.accounts.patch("a", { cap: 50 }));
  await assert.rejects(start(f, "new", 0), QuotaExceeded);
  f.objects.set(input.uploadId, { size: 100, version: "v1" });
  await finalizeUpload(f.ctx, input);
  await claimSummary(f.ctx, { ...input, attempt: 1 });
  await finishSummary(f.ctx, { ...input, attempt: 1, text: "summary" });
  assert.deepEqual(f.state().accounts.get("a"), { id: "a", used: 107, reserved: 0, cap: 50 });
  await closeUpload(f.ctx, { ...input, reason: "delete" });
  f.invariant();
});

test("cleanup outbox failure rolls back deletion and refunds", async () => {
  const f = fixture();
  const input = await ready(f);
  f.control.failEnqueue = true;
  await assert.rejects(closeUpload(f.ctx, { ...input, reason: "delete" }), /outbox unavailable/);
  assert.equal(f.state().uploads.get(input.uploadId).status, "ready");
  assert.equal(f.state().accounts.get("a").used, 100);
  assert.equal(f.state().accounts.get("a").reserved, S);
  f.invariant();
});

test("request IDs are account-scoped and summary/deletion actions enforce ownership", async () => {
  const f = fixture();
  const input = await ready(f);
  const otherCtx = { ...f.ctx, accountId: "b" };
  const other = await startUpload(otherCtx, { name: "document.txt", size: 100, requestId: "one" });
  assert.notEqual(other.uploadId, input.uploadId);
  await assert.rejects(claimSummary(otherCtx, input), code("not_found"));
  await assert.rejects(finishSummary(otherCtx, { ...input, text: "foreign" }), code("not_found"));
  await assert.rejects(retrySummary(otherCtx, { ...input, requestId: "retry" }), code("not_found"));
  await assert.rejects(closeUpload(otherCtx, { ...input, reason: "delete" }), code("not_found"));
  f.invariant();
});
