+    patch(id: string, values: Partial<Upload>): Promise<void>;
+  };
+  summaryJobs: {
+    // Durable job/outbox row, unique on uploadId; committed with ready + usage.
+    insert(job: { uploadId: string; accountId: string; status: "queued" }): Promise<void>;
