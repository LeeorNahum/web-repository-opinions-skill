import assert from "node:assert/strict";
import { test } from "node:test";
import { startUpload, finalizeUpload, cancelUpload, expireUploads, RESERVATION_TTL_MS } from "./uploads.ts";
import { QuotaExceeded } from "./errors.ts";

function fixture(cap = 100) {
  let state = {
    accounts: { a: { id: "a", used: 0, reserved: 0, cap }, b: { id: "b", used: 0, reserved: 0, cap } },
    uploads: {}, jobs: [], next: 0,
  };
  let clock = 1000;
  let tail = Promise.resolve();
  const objects = new Map();
  const control = { failJob: false, failSign: false, seals: 0, onSeal: null };
  const ctx = {
    accountId: "a", now: () => clock,
    db: {
      transaction(run) {
        const result = tail.then(async () => {
          const draft = structuredClone(state);
          const tx = {
            accounts: {
              get: async id => structuredClone(draft.accounts[id]),
              patch: async (id, values) => Object.assign(draft.accounts[id], values),
            },
            uploads: {
              get: async id => structuredClone(draft.uploads[id] ?? null),
              findByKey: async (accountId, key) => structuredClone(Object.values(draft.uploads)
                .find(u => u.accountId === accountId && u.idempotencyKey === key) ?? null),
              listPending: async accountId => structuredClone(Object.values(draft.uploads)
                .filter(u => u.accountId === accountId && u.status === "pending")),
              insert: async values => {
                const row = { id: String(++draft.next), ...values };
                draft.uploads[row.id] = row;
                return structuredClone(row);
              },
              patch: async (id, values) => Object.assign(draft.uploads[id], values),
            },
            summaryJobs: { insert: async job => {
              if (control.failJob) throw new Error("database unavailable");
              assert(!draft.jobs.some(j => j.uploadId === job.uploadId));
              draft.jobs.push(job);
            } },
          };
          const value = await run(tx);
          state = draft;
          return value;
        });
        tail = result.catch(() => {});
        return result;
      },
    },
    storage: {
      signPut: async (id, options) => {
        if (control.failSign) throw new Error("signing unavailable");
        assert(options.maxBytes > 0);
        assert(options.expiresAt > clock);
        return `https://storage.invalid/${id}`;
      },
      seal: async id => {
        control.seals++;
        if (control.onSeal) await control.onSeal();
        if (!objects.has(id)) throw new Error("incomplete upload");
        return { size: objects.get(id), version: `immutable-${id}` };
      },
    },
  };
  const start = (key, size = 20) => startUpload(ctx, { name: `${key}.pdf`, size, idempotencyKey: key });
  return { ctx, start, objects, control, state: () => state, advance: ms => { clock += ms; } };
}

test("eight concurrent starts cannot oversubscribe the account", async () => {
  const f = fixture();
  const results = await Promise.allSettled(Array.from({ length: 8 }, (_, i) => f.start(String(i))));
  assert.equal(results.filter(r => r.status === "fulfilled").length, 5);
  for (const r of results.filter(r => r.status === "rejected")) assert(r.reason instanceof QuotaExceeded);
  assert.deepEqual(f.state().accounts.a, { id: "a", used: 0, reserved: 100, cap: 100 });
});

test("concurrent start replays share a reservation and reject conflicting payloads", async () => {
  const f = fixture();
  const results = await Promise.all(Array.from({ length: 8 }, () => f.start("same")));
  assert.equal(new Set(results.map(r => r.uploadId)).size, 1);
  assert.equal(f.state().accounts.a.reserved, 20);
  await assert.rejects(f.start("same", 21), /another file/);
  f.control.failSign = true;
  await assert.rejects(f.start("recover"), /signing/);
  f.control.failSign = false;
  await f.start("recover");
  assert.equal(f.state().accounts.a.reserved, 40);
});

test("concurrent finalize retries charge measured bytes and queue one summary", async () => {
  const f = fixture();
  const upload = await f.start("one", 100);
  f.objects.set(upload.uploadId, 75);
  await Promise.all(Array.from({ length: 8 }, () => finalizeUpload(f.ctx, upload)));
  assert.equal(f.state().accounts.a.used, 75);
  assert.equal(f.state().accounts.a.reserved, 0);
  assert.equal(f.state().jobs.length, 1);
  assert.equal(f.state().uploads[upload.uploadId].actualSize, 75);
  assert.equal((await f.start("one", 100)).status, "ready");
  await f.start("two", 25);
});

test("job insertion failure rolls back the entire finalize and allows retry", async () => {
  const f = fixture();
  const upload = await f.start("one");
  f.objects.set(upload.uploadId, 20);
  f.control.failJob = true;
  await assert.rejects(finalizeUpload(f.ctx, upload), /database unavailable/);
  assert.equal(f.state().accounts.a.used, 0);
  assert.equal(f.state().accounts.a.reserved, 20);
  assert.equal(f.state().uploads[upload.uploadId].status, "pending");
  f.control.failJob = false;
  await finalizeUpload(f.ctx, upload);
  assert.equal(f.state().jobs.length, 1);
});

test("expiry releases once, rejects stale keys, and lets new work use the space", async () => {
  const f = fixture();
  const upload = await f.start("one", 100);
  f.advance(RESERVATION_TTL_MS);
  await assert.rejects(f.start("one", 100), /Upload closed/);
  assert.equal(f.state().accounts.a.reserved, 0);
  await Promise.all([expireUploads(f.ctx), expireUploads(f.ctx)]);
  await assert.rejects(finalizeUpload(f.ctx, upload), /Upload closed/);
  await f.start("two", 100);
  assert.equal(f.state().accounts.a.reserved, 100);
});

test("expiry while storage is sealing cannot charge or queue paid work", async () => {
  const f = fixture();
  const upload = await f.start("one");
  f.objects.set(upload.uploadId, 20);
  f.control.onSeal = async () => f.advance(RESERVATION_TTL_MS);
  await assert.rejects(finalizeUpload(f.ctx, upload), /Upload closed/);
  assert.equal(f.state().accounts.a.used, 0);
  assert.equal(f.state().accounts.a.reserved, 0);
  assert.equal(f.state().jobs.length, 0);
});

test("cancellation racing finalization releases once and prevents charging", async () => {
  const f = fixture();
  const upload = await f.start("one");
  f.objects.set(upload.uploadId, 20);
  f.control.onSeal = async () => {
    await Promise.all([cancelUpload(f.ctx, upload), cancelUpload(f.ctx, upload)]);
  };
  await assert.rejects(finalizeUpload(f.ctx, upload), /Upload closed/);
  assert.equal(f.state().accounts.a.used, 0);
  assert.equal(f.state().accounts.a.reserved, 0);
  assert.equal(f.state().jobs.length, 0);
});

test("cross-account finalize and cancel fail before storage access", async () => {
  const f = fixture();
  const upload = await f.start("one");
  const stranger = { ...f.ctx, accountId: "b" };
  await assert.rejects(finalizeUpload(stranger, upload), /not found/);
  await assert.rejects(cancelUpload(stranger, upload), /not found/);
  assert.equal(f.control.seals, 0);
  assert.equal(f.state().accounts.a.reserved, 20);
});

test("missing or invalid stored bytes never charge or create a summary", async () => {
  const f = fixture();
  const upload = await f.start("one");
  await assert.rejects(finalizeUpload(f.ctx, upload), /incomplete/);
  for (const size of [21, -1, 0, NaN, 2.5, Infinity]) {
    f.objects.set(upload.uploadId, size);
    await assert.rejects(finalizeUpload(f.ctx, upload), /size is invalid/);
  }
  assert.equal(f.state().accounts.a.used, 0);
  assert.equal(f.state().jobs.length, 0);
});

test("invalid declared sizes are rejected before any reservation", async () => {
  const f = fixture();
  for (const size of [0, -1, NaN, Infinity, 1.5, Number.MAX_SAFE_INTEGER + 1]) {
    await assert.rejects(f.start("bad", size), /positive, safe integer/);
  }
  assert.equal(f.state().accounts.a.reserved, 0);
});

test("pending count is bounded independently of byte capacity", async () => {
  const f = fixture(1000);
  for (let i = 0; i < 64; i++) await f.start(String(i), 1);
  await assert.rejects(f.start("overflow", 1), /Too many pending/);
  assert.equal(f.state().accounts.a.reserved, 64);
});

test("admission includes committed bytes and honors reservations after a downgrade", async () => {
  const f = fixture();
  const first = await f.start("one", 60);
  f.objects.set(first.uploadId, 60);
  await finalizeUpload(f.ctx, first);
  await assert.rejects(f.start("too-large", 41), QuotaExceeded);
  const second = await f.start("two", 40);
  f.state().accounts.a.cap = 70;
  f.objects.set(second.uploadId, 35);
  await finalizeUpload(f.ctx, second);
  assert.equal(f.state().accounts.a.used, 95);
  assert.equal(f.state().accounts.a.reserved, 0);
  await assert.rejects(f.start("three", 1), QuotaExceeded);
});

test("request keys are account scoped and caller fields cannot override ownership", async () => {
  const f = fixture();
  const first = await startUpload(f.ctx, {
    name: "one.pdf", size: 20, idempotencyKey: "one", accountId: "b",
  });
  assert.equal(f.state().uploads[first.uploadId].accountId, "a");
  const second = await startUpload({ ...f.ctx, accountId: "b" }, {
    name: "one.pdf", size: 20, idempotencyKey: "one",
  });
  assert.notEqual(first.uploadId, second.uploadId);
  assert.equal(f.state().accounts.a.reserved, 20);
  assert.equal(f.state().accounts.b.reserved, 20);
});
