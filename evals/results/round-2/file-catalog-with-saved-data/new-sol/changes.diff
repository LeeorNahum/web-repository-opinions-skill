  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "Path": { "type": "string", "minLength": 2, "maxLength": 1024, "pattern": "^/" },
    "Cursor": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "Content": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "properties": { "text": { "type": "string", "maxLength": 131072 } },
          "required": ["text"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "source_url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 4096 }
          },
          "required": ["source_url"]
        }
      ]
    },
    "Edit": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "old_text": { "type": "string", "minLength": 1, "maxLength": 131072 },
